# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

# --- LLM backend (Groq API) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Jenkins connector ---
JENKINS_URL=https://jenkins.yourcompany.com
JENKINS_USER=your.username
JENKINS_API_TOKEN=your_jenkins_api_token

# --- Jira connector ---
JIRA_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=your.email@yourcompany.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=ACC

# --- Polarion connector (Phase 2) ---
POLARION_URL=https://polarion.yourcompany.com/polarion
POLARION_TOKEN=your_polarion_personal_access_token
POLARION_PROJECT_ID=your_project_id

# --- CANoe (file-based path) ---
CANOE_LOG_PATH=//fileserver/canoe_reports/
